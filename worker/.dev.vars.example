# Cloudflare Worker Secrets Template (save as .dev.vars for local dev)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
OPENAQ_API_KEY=your-openaq-api-key
CPCB_API_KEY=your-cpcb-data.gov.in-api-key

# Optional CORS allowlist (not a secret): extra comma-separated browser origins
# allowed to call the API cross-origin. http://localhost:5173 is always allowed.
# ALLOWED_ORIGIN=https://your-app.pages.dev
